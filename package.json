{
  "name": "tentacle",
  "private": true,
  "version": "0.0.0",
  "description": "Tentacle — a curated DSH plugin bundle: multi-tenant, multi-channel, multi-expert.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build",
    "test": "pnpm -r --filter='./packages/*' test",
    "typecheck": "pnpm -r build && pnpm -r --filter='./packages/*' typecheck",
    "test:e2e": "bash tests/e2e/e2e.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
