{
  "name": "@tentacle/channels",
  "version": "0.0.1",
  "description": "Tenant-scoped, runtime-managed IM channel instances for DSH: platform adapters that turn inbound messages into tenant-bound sessions and stream replies back.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-webhook": "^0.2.1-alpha.2",
    "@larksuiteoapi/node-sdk": "^1.75.0",
    "@tentacle/crypto": "workspace:*",
    "@tentacle/identity": "workspace:*",
    "@tentacle/persona": "workspace:*",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@tentacle/gateway": "0.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@tentacle/gateway": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/qrcode-generator": "^1.0.6",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.2",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "ws": "^8.22.0"
  }
}
